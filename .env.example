# Copy this file to `.env.local` (and `.env` for Prisma) and fill in the values.
# Never commit real secrets. `.env*.local` is gitignored.

# ===========================================
# Application
# ===========================================
# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Matches the defaults in docker-compose.yml for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_platform?schema=public"

# ===========================================
# Auth.js v5 (NextAuth)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL Auth.js trusts for callbacks. Usually the same as the app URL.
AUTH_URL="http://localhost:3000"

# Google OAuth provider (optional in Fase 1)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===========================================
# Payment (Fase 2)
# ===========================================
# Tidak ada. Checkout-nya dummy/simulasi — no payment gateway, no keys.
# Transaksi tetap tercatat di tabel Transaction. Lihat docs/plan/phase-2-checkout.md.

# ===========================================
# Mux — Video (Fase 4)
# ===========================================
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# ===========================================
# Cloudflare R2 — Storage
# ===========================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ===========================================
# Resend — Email (Fase 5)
# ===========================================
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"
